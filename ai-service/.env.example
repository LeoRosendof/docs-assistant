# Copie para .env (que o git ignora) e ajuste. Para o uvicorn ler o arquivo:
#   python -m uvicorn app.main:app --env-file .env
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODELO=llama3.1:8b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=512
OLLAMA_EMBED_URL=http://localhost:11434/api/embed
OLLAMA_EMBED_MODELO=bge-m3
# Prefixos do modelo de embedding (vazios para o bge-m3). Para o nomic-embed-text:
#   EMBED_PREFIXO_DOCUMENTO="search_document: "
#   EMBED_PREFIXO_PERGUNTA="search_query: "
EMBED_PREFIXO_DOCUMENTO=
EMBED_PREFIXO_PERGUNTA=
# Score mínimo de similaridade para usar um trecho (depende do modelo de embedding).
RAG_SCORE_MINIMO=0.40
RAG_TEMPERATURA=0
CHUNK_TAMANHO=1000
CHUNK_SOBREPOSICAO=200
